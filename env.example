# Copy this to .env for local development (never commit .env to git)
# On Railway: add these under your project's Variables tab

# Calimatic Public API Key
# Format: https://portal.icodeschool.com|YOUR_KEY
PUBLIC_API_KEY=https://portal.icodeschool.com|YOUR_KEY_HERE

# Calimatic login credentials (used for bearer token endpoints)
CALIMATIC_USERNAME=your@email.com
CALIMATIC_PASSWORD=yourpassword

# Port (Railway sets this automatically — don't change)
# PORT=3000
